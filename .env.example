# สร้าง Webhook ที่ Discord: Edit Channel > Integrations > Webhooks
URL_WEBHOOK=https://discord.com/api/webhooks/ใส่_webhook_id/ใส่_webhook_token

# Upstash Redis (จำเป็น) สำหรับเก็บประวัติและ lock ป้องกันการแจ้งซ้ำ
UPSTASH_REDIS_REST_URL=https://ใส่ชื่อฐานข้อมูล.upstash.io
UPSTASH_REDIS_REST_TOKEN=ใส่_rest_token
STATE_KEY=discord-status-webhook:state
UPSTASH_KEEPALIVE_SECONDS=21600

# ตรวจทุก 15 วินาที
POLL_INTERVAL_SECONDS=15

# true = แจ้งกำหนดการบำรุงรักษาด้วย, false = แจ้งเฉพาะ incident
INCLUDE_MAINTENANCE=true

# เขตเวลาที่ใช้แสดงในข้อความ
TIME_ZONE=Asia/Bangkok

# ระยะ timeout ของ HTTP request
REQUEST_TIMEOUT_SECONDS=15

# พอร์ต HTTP สำหรับ /health (Render จะกำหนด PORT ให้อัตโนมัติ)
PORT=3000
